# Copy to supabase/functions/.env for `npm run functions:serve` (local only).
# In production set these with: npx supabase secrets set PROCESSOR_SECRET=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
PROCESSOR_SECRET=same-value-as-PROCESSOR_SECRET-in-.env.local
# Optional: keep any LIMIT_* overrides identical to the web app's values.
# LIMIT_MAX_TEMPLATE_FILE_BYTES=20971520
