# Cloudflare Workers Static Assets headers. These files are served without
# running the Worker, so the middleware headers do not reach them.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Build output has a content hash in every file name, so it never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
