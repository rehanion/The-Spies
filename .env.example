# ---- Public (inlined into the browser bundle; safe to expose) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "publishable" key (sb_publishable_...). Row Level Security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Cloudflare Turnstile site key. Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server only (Cloudflare Worker secrets; never commit real values) ----
# Supabase "secret" key (sb_secret_...). Bypasses RLS. Server only.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Shared secret between the app server and the process-upload Edge Function (>= 32 chars).
PROCESSOR_SECRET=REPLACE_WITH_64_HEX_CHARS
# Optional: defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1
SUPABASE_FUNCTIONS_URL=
# Salt for hashing IP addresses/user ids in download de-duplication (>= 32 random chars).
ACTOR_HASH_SALT=REPLACE_WITH_RANDOM_STRING
# Cloudflare Turnstile secret key. Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Local development only: allow forms without Turnstile when no secret is set.
TURNSTILE_DISABLED=false
# Require an account to download (recommended: limits egress abuse on the free plan).
DOWNLOAD_REQUIRE_LOGIN=true
# Lifetime of signed download URLs, 10-300 seconds.
DOWNLOAD_URL_TTL_SECONDS=60
# Emergency switch: stop accepting new uploads.
UPLOADS_PAUSED=false

# ---- Optional limit overrides (bytes / counts). Defaults in supabase/functions/_shared/limits.ts ----
# LIMIT_MAX_TEMPLATE_FILE_BYTES=20971520
# LIMIT_MAX_FILES_PER_TEMPLATE=5
# LIMIT_MAX_SCREENSHOT_BYTES=8388608
# LIMIT_MAX_SCREENSHOTS_PER_TEMPLATE=8
# LIMIT_PER_USER_STORAGE_BYTES=157286400
# LIMIT_PER_USER_DAILY_UPLOADS=40
# LIMIT_PER_USER_DAILY_SUBMISSIONS=5
# LIMIT_PLATFORM_STORAGE_SOFT_LIMIT_BYTES=838860800
